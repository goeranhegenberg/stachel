{
  "name": "stachel-server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.dev.json --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/src/index.js",
    "admin": "tsx --tsconfig tsconfig.dev.json --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts admin",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.9",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@hocuspocus/server": "4.8.0",
    "fastify": "5.12.7",
    "fractional-indexing": "4.0.0",
    "nanoid": "6.0.2",
    "sharp": "0.35.5",
    "ws": "8.22.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
