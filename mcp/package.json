{
  "name": "stachel-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "MCP-Server für Stachel: KI-Assistenten lesen, gestalten und fotografieren Boards live (stdio und Streamable HTTP)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "stachel-mcp": "bin/stachel-mcp.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/stachel-mcp.mjs serve",
    "stdio": "node dist/stachel-mcp.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "pack": "npm run build && npm pack --pack-destination dist"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fractional-indexing": "4.0.0",
    "nanoid": "6.0.2",
    "playwright-core": "1.64.1",
    "ws": "8.22.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "files": [
    "bin",
    "dist/stachel-mcp.mjs"
  ]
}
