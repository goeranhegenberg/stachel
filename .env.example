# Stachel – configuration. Copy to `.env` next to docker-compose.yml (or server/.env for `npm run dev`).
# Every variable is optional; the defaults below run a self-hosted instance with own accounts on http://localhost:8080.
# Full reference: README.md → Configuration.

# ---- Basics ----
# Public address (origin) of this instance: links in e-mails and QR codes, WebSocket origin check, Secure cookies.
# Default: http://localhost:<PORT>. Set it to your real address, e.g. https://board.example.org
#PUBLIC_URL=http://localhost:8080
# Port inside the container (the Docker image listens on 8080; `npm run dev` on 8095)
#PORT=8080
# Secure cookies (default: true exactly when PUBLIC_URL starts with https://)
#COOKIE_SECURE=
# Trust X-Forwarded-For from these proxies (rate limits use the client IP). Fastify trustProxy syntax.
#TRUST_PROXY=loopback,uniquelocal
# Additional allowed WebSocket origins, comma separated (normally empty)
#ALLOWED_ORIGINS=
# trace | debug | info | warn | error | silent
#LOG_LEVEL=info
# Encrypt stored login tokens in SQLite (AES-256-GCM). 32 bytes, e.g. `openssl rand -base64 32`. Recommended; required in
# org mode. Never change or lose it (everyone would have to log in again) - back it up together with .env.
#STACHEL_TOKEN_KEY=

# ---- Instance and accounts ----
# local (default): own accounts with registration, captcha and optional e-mail confirmation.
# org: login through the identity service of an external organisation (club, company, event team …), see
#      "Org mode" below and docs/contract.md §1. Any other value stops the server at start.
#STACHEL_AUTH=local
# Name of the instance in the UI and in e-mails
#STACHEL_BRAND=Stachel
# open (default): everyone may register | invite: only people with a pending board invitation (the very first account
# may always register, so a fresh instance can be set up)
#STACHEL_REGISTRATION=open
# Confirm the e-mail address before the first login. Default: on when SMTP is configured, off without SMTP (accounts are
# active right away). Manage accounts with `docker exec <container> stachel-admin users|verify <email>|reset-link <email>`.
#STACHEL_REQUIRE_VERIFICATION=
# Your legal texts as pages served by Stachel: put impressum.html, datenschutz.html, nutzungsbedingungen.html (HTML
# fragments, templates in deploy/legal-templates/) into DATA_DIR/legal – they appear under /impressum, /datenschutz,
# /nutzungsbedingungen and are linked automatically when the URLs below are empty. Nothing is shipped by default.
#STACHEL_LEGAL_DIR=/data/legal
# Version of your terms (e.g. 2026-11-04): stored with the consent; when it changes, logged-in people are asked again
#STACHEL_TERMS_VERSION=
# Links to your imprint and privacy policy elsewhere (footer, registration, e-mails)
#STACHEL_IMPRINT_URL=https://example.org/imprint
#STACHEL_PRIVACY_URL=https://example.org/privacy
# Terms of service (registration checkbox "I accept the terms of service and am at least 18 years old", footer, e-mails);
# empty = checkbox without a link and a warning at startup (local mode)
#STACHEL_TERMS_URL=https://example.org/terms
# Captcha difficulty (proof of work in the browser, no third party), default 250000
#STACHEL_CAPTCHA_MAX=250000
# Instance templates: *.json files shown in the template gallery under one category (docs/selfhosting.md);
# default folder DATA_DIR/templates, default category STACHEL_BRAND (or „Weitere Vorlagen“)
#STACHEL_TEMPLATES_DIR=/data/templates
#STACHEL_TEMPLATES_CATEGORY=Unsere Vorlagen

# ---- E-mail (SMTP, optional) ----
# Without STACHEL_SMTP_HOST no mail is sent: messages incl. their links go to the server log and DATA_DIR/mail.log.
#STACHEL_SMTP_HOST=smtp.example.org
#STACHEL_SMTP_PORT=465
# ssl (default for 465) | starttls (default otherwise) | none (local tests only)
#STACHEL_SMTP_SECURE=
#STACHEL_SMTP_USER=noreply@example.org
#STACHEL_SMTP_PASS=
#STACHEL_SMTP_FROM=Stachel <noreply@example.org>
# smtp (default) | log = never send, only write DATA_DIR/mail.log (tests and sandbox)
#STACHEL_MAIL_MODE=smtp

# ---- Web app path and product page ----
# Serve the web app under a path, e.g. /app (API, sync and app links stay at the root). Empty = at the root.
#STACHEL_BASE_PATH=
# Product page at / (only together with STACHEL_BASE_PATH): 1 = on
#STACHEL_LANDING=
# Links on the product page: source code and Google Play (empty = hidden / "coming soon")
#STACHEL_REPO_URL=https://github.com/goeranhegenberg/stachel
#STACHEL_PLAY_URL=

# ---- Reports and moderation (docs/features/moderation.md, operations: docs/ops/moderation.md) ----
# Reports (DSA Art. 16, app store UGC rules) are e-mailed to this address; empty = STACHEL_SMTP_FROM. Needs SMTP
# (STACHEL_SMTP_*) in org mode too, otherwise they only end up in DATA_DIR/mail.log.
#STACHEL_REPORT_EMAIL=moderation@example.org
# Admin API for tools/admin.mts (decide reports, lock boards/accounts); at least 32 characters, empty = off.
# Generate with `openssl rand -base64 36`; keep it in .env only (never in the repo).
#STACHEL_ADMIN_TOKEN=

# ---- Import from Miro (docs/features/import.md) ----
# off = no import at all | the personal access token way can be switched off separately
#STACHEL_IMPORT=on
#STACHEL_IMPORT_MIRO_TOKEN=on
# Your own Miro app ("Connect with Miro", OAuth): both set = button shown. Redirect URI default
# {PUBLIC_URL}/api/import/miro/callback - enter exactly this in the Miro app. Refresh tokens are stored encrypted
# (key from STACHEL_TOKEN_KEY, otherwise DATA_DIR/import-secret.key - back it up with the data folder).
#MIRO_CLIENT_ID=
#MIRO_CLIENT_SECRET=
#MIRO_REDIRECT_URI=
# Imports running at the same time (instance), boards per person and day, objects and images per board
#STACHEL_IMPORT_CONCURRENCY=2
#STACHEL_IMPORTS_PER_DAY=20
#STACHEL_IMPORT_MAX_OBJECTS=20000
#STACHEL_IMPORT_MAX_IMAGES=1000
# Additional allowed file hosts for images/PDFs (comma separated, `*.` allowed)
#STACHEL_IMPORT_MIRO_HOSTS=
# Tests/development only (fake Miro, tools/miro-fake.mts): API and authorization page under this address
#STACHEL_IMPORT_MIRO_API_BASE=
#STACHEL_IMPORT_MIRO_AUTH_BASE=

# ---- AI access (MCP) ----
# Address of the MCP server shown in the "AI access" dialog. Default: {PUBLIC_URL}/mcp (reverse proxy routes /mcp to the
# stachel-mcp container, see docker-compose.yml profiles mcp/https)
#MCP_PUBLIC_URL=

# ---- Native apps (optional) ----
# Android App Links (/.well-known/assetlinks.json): package name and SHA-256 fingerprints of the signing certificate(s),
# comma separated. Empty = no App Links (404). iOS Universal Links: Team-ID.bundle-id.
#STACHEL_ANDROID_PACKAGE=
#STACHEL_ANDROID_CERT_SHA256=
#STACHEL_IOS_APP_ID=
# Minimum app versions for the native API (hello.client); empty = none
#STACHEL_NATIVE_MIN_APP=
#STACHEL_NATIVE_MIN_STACHEL_APP=
# Sandbox actions of the native API (dev.*) – testing only, never in production
#STACHEL_NATIVE_DEV_ACTIONS=

# ---- Org mode only (STACHEL_AUTH=org, docs/contract.md §1) ----
# Required: full URL that checks an org token. Stachel sends `GET <url>` with `Authorization: Bearer <org-token>` and
# expects {"id": "m:12", "name": "Mara", "admin": false, "status": "active|pending|blocked"}; `id` becomes the user key.
#STACHEL_ORG_IDENTITY_URL=https://id.example.org/api/stachel/me
# Optional: username + password login through the organisation (`POST <url>` {username, password} → {token}).
# Empty = no password login (only QR pairing and the organisation's app).
#STACHEL_ORG_LOGIN_URL=
# Name of the organisation and of its app in texts ("Mit {name} anmelden", "In der {app name} öffnen")
#STACHEL_ORG_NAME=Organisation
#STACHEL_ORG_APP_NAME=Organisation-App
# Timeout per call to the identity service in ms
#STACHEL_ORG_TIMEOUT_MS=8000

# ---- Paths (set by the Docker image; only needed for `npm run dev` / bare-metal) ----
#DATA_DIR=./data
#WEB_DIST=../web/dist
#HOST=0.0.0.0

# ---- docker-compose.yml only (not read by the server) ----
# Host port for Stachel (default 8080) and for the optional MCP container (default 8096)
#STACHEL_HTTP_PORT=8080
#STACHEL_MCP_PORT=8096
# Image tag (default latest), e.g. 1.0.0
#STACHEL_VERSION=latest
# Domain for the Caddy profile (automatic HTTPS); set PUBLIC_URL=https://<domain> as well
#STACHEL_DOMAIN=board.example.org
